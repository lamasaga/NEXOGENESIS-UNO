      "width": 160,
      "height": 92
    },
    {
      "id": "I",
      "lane": "settle",
      "col": 0,
      "type": "frontend",
      "label": "I · 确认本批",
      "sublabel": "手动／信任两种",
      "tag": "近重始终需要确认",
      "width": 160,
      "height": 92
    },
    {
      "id": "J",
      "lane": "settle",
      "col": 1,
      "type": "database",
      "label": "J · 保存卡片与收据",
