      "tag": "人工选材",
      "width": 160,
      "height": 92
    },
    {
      "id": "B",
      "lane": "intake",
      "col": 1,
      "type": "backend",
      "label": "B · 提取文本",
      "sublabel": "≤20 MiB；≤200万字",
      "tag": "程序提取文本",
      "width": 160,
      "height": 92
    },
    {
      "id": "C",
      "lane": "intake",
      "col": 2,
      "type": "backend",
      "label": "C · 切分原文",
