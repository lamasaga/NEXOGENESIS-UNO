      "width": 160,
      "height": 92
    },
    {
      "id": "E",
      "lane": "summary",
      "col": 3,
      "type": "backend",
      "label": "E · 组成批次",
      "sublabel": "1–2单元；≤12,000字",
      "tag": "按顺序取，不语义组稿",
      "width": 160,
      "height": 92
    },
    {
      "id": "F",
      "lane": "summary",
      "col": 2,
      "type": "cloud",
      "label": "F · 模型摘要",
      "sublabel": "1次请求；0–6张卡",
      "tag": "输出预算8,000 tokens",
      "width": 160,
      "height": 92
    },
    {
      "id": "G",
      "lane": "summary",
      "col": 1,
      "type": "security",
      "label": "G · 格式与来源检查",
      "sublabel": "正文40–5,000字",
      "tag": "TAG 1–12；格式校验",
      "width": 160,
      "height": 92
    },
    {
      "id": "H",
      "lane": "summary",
      "col": 0,
      "type": "backend",
      "label": "H · 标题近重检查",
