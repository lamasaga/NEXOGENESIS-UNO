          "label": "大模型"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "intake",
      "label": "A–D · 原文准备 →"
    },
    {
      "id": "summary",
      "label": "← E–H · 单批摘要"
    },
    {
      "id": "settle",
      "label": "I–L · 确认与收尾 →"
    }
  ],
  "nodes": [
    {
      "id": "A",
      "lane": "intake",
      "col": 0,
      "type": "frontend",
      "label": "A · 选材与主题",
