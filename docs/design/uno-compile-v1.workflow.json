      "tag": "保存来源状态和收据",
      "width": 160,
      "height": 92
    },
    {
      "id": "K",
      "lane": "settle",
      "col": 2,
      "type": "backend",
      "label": "K · 推进或暂停",
      "sublabel": "≤12步／10分钟",
      "tag": "下一批、暂停或结束",
      "width": 160,
      "height": 92
    },
    {
      "id": "L",
      "lane": "settle",
      "col": 3,
      "type": "database",
      "label": "L · 归档与结果",
      "sublabel": "全部单元有去向",
      "tag": "PDF／失败原件保留",
      "width": 160,
      "height": 92
    }
