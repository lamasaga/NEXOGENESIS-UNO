{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FT-002 checkpoint output",
  "type": "object",
  "required": ["case_id", "checkpoint", "as_of", "previous_checkpoint", "evidence_anchors", "update_delta", "limitations", "country_forecasts", "regional_probabilities", "mechanisms", "regional_scenarios", "country_update_summary", "next_signals"],
  "properties": {
    "case_id": {"const": "FT-002"},
    "checkpoint": {"enum": ["T0", "T1", "T2"]},
    "as_of": {"type": "string", "format": "date-time"},
    "previous_checkpoint": {"enum": [null, "T0", "T1"]},
    "evidence_anchors": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/evidenceAnchor"}},
    "update_delta": {"$ref": "#/$defs/updateDelta"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "country_forecasts": {
      "type": "object",
      "required": ["C1", "C2", "C3", "C4"],
      "properties": {
        "C1": {"$ref": "#/$defs/countryForecast"},
        "C2": {"$ref": "#/$defs/countryForecast"},
        "C3": {"$ref": "#/$defs/countryForecast"},
        "C4": {"$ref": "#/$defs/countryForecast"}
      },
      "additionalProperties": false
    },
    "regional_probabilities": {
      "type": "object",
      "required": ["at_least_three_contract", "median_gdp_growth_le_minus_5"],
      "properties": {
        "at_least_three_contract": {"$ref": "#/$defs/probability"},
        "median_gdp_growth_le_minus_5": {"$ref": "#/$defs/probability"}
      },
      "additionalProperties": false
    },
    "mechanisms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["name", "countries", "weight", "evidence", "disconfirming_evidence", "observable_signals"],
        "properties": {
          "name": {"type": "string"},
          "countries": {"type": "array", "items": {"enum": ["C1", "C2", "C3", "C4"]}, "uniqueItems": true},
          "weight": {"$ref": "#/$defs/probability"},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "disconfirming_evidence": {"type": "array", "items": {"type": "string"}},
          "observable_signals": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "regional_scenarios": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["name", "probability", "description", "country_outcomes", "triggers"],
        "properties": {
          "name": {"type": "string"},
          "probability": {"$ref": "#/$defs/probability"},
          "description": {"type": "string"},
          "country_outcomes": {"type": "object"},
          "triggers": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "country_update_summary": {
      "type": "object",
      "required": ["C1", "C2", "C3", "C4", "regional"],
      "properties": {
        "C1": {"type": "string"},
        "C2": {"type": "string"},
        "C3": {"type": "string"},
        "C4": {"type": "string"},
        "regional": {"type": "string"}
      },
      "additionalProperties": false
    },
    "next_signals": {"type": "array", "items": {"type": "string"}},
    "source_ids_used": {"type": "array", "items": {"type": "string", "pattern": "^S[0-9]{2}$"}}
  },
  "$defs": {
    "probability": {"type": "number", "minimum": 0, "maximum": 1},
    "interval": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "evidenceAnchor": {
      "type": "object", "additionalProperties": false,
      "required": ["supports", "kind", "anchor", "use"],
      "properties": {
        "supports": {"type": "string"},
        "kind": {"enum": ["support", "counter", "boundary"]},
        "anchor": {"type": "string", "pattern": "^(S[0-9]{2}|FT002-[A-Z][0-9]{2})(#[A-Za-z0-9._-]+)?$"},
        "use": {"type": "string"}
      }
    },
    "updateDelta": {
      "type": "object", "additionalProperties": false,
      "required": ["changed", "unchanged", "why"],
      "properties": {
        "changed": {"type": "array", "items": {"type": "string"}},
        "unchanged": {"type": "array", "items": {"type": "string"}},
        "why": {"type": "string"}
      }
    },
    "countryForecast": {
      "type": "object",
      "required": ["contraction_probability", "gdp_growth", "currency_depreciation_ge_30_probability", "current_account_surplus_probability", "severity_rank", "main_vulnerabilities", "mitigating_factors", "evidence", "disconfirming_evidence"],
      "properties": {
        "contraction_probability": {"$ref": "#/$defs/probability"},
        "gdp_growth": {
          "type": "object",
          "required": ["point", "interval_50", "interval_90"],
          "properties": {
            "point": {"type": "number"},
            "interval_50": {"$ref": "#/$defs/interval"},
            "interval_90": {"$ref": "#/$defs/interval"}
          }
        },
        "currency_depreciation_ge_30_probability": {"$ref": "#/$defs/probability"},
        "current_account_surplus_probability": {"$ref": "#/$defs/probability"},
        "severity_rank": {"type": "integer", "minimum": 1, "maximum": 4},
        "main_vulnerabilities": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string"}},
        "mitigating_factors": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "disconfirming_evidence": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "additionalProperties": false
}
