{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexogenesis://eval/common-envelope/0.2.0",
  "title": "历史情景评测共同输出外壳",
  "type": "object",
  "required": ["case_id", "checkpoint", "as_of", "previous_checkpoint", "evidence_anchors", "update_delta", "limitations"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^FT-[0-9]{3}$"},
    "checkpoint": {"type": "string", "pattern": "^T[0-9]+$"},
    "as_of": {"type": "string", "format": "date-time"},
    "previous_checkpoint": {"type": ["string", "null"]},
    "evidence_anchors": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidenceAnchor"}
    },
    "update_delta": {"$ref": "#/$defs/updateDelta"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "evidenceAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supports", "kind", "anchor", "use"],
      "properties": {
        "supports": {"type": "string"},
        "kind": {"enum": ["support", "counter", "boundary"]},
        "anchor": {"type": "string"},
        "use": {"type": "string"}
      }
    },
    "updateDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed", "unchanged", "why"],
      "properties": {
        "changed": {"type": "array", "items": {"type": "string"}},
        "unchanged": {"type": "array", "items": {"type": "string"}},
        "why": {"type": "string"}
      }
    }
  }
}
