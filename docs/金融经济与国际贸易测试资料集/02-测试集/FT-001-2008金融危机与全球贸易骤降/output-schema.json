{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FT-001 checkpoint output",
  "type": "object",
  "required": ["case_id", "checkpoint", "as_of", "previous_checkpoint", "evidence_anchors", "update_delta", "limitations", "event_probabilities", "numeric_forecast", "mechanisms", "scenarios", "next_signals"],
  "properties": {
    "case_id": {"const": "FT-001"},
    "checkpoint": {"enum": ["T0", "T1", "T2"]},
    "as_of": {"type": "string", "format": "date-time"},
    "previous_checkpoint": {"enum": [null, "T0", "T1"]},
    "evidence_anchors": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/evidenceAnchor"}},
    "update_delta": {"$ref": "#/$defs/updateDelta"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "event_probabilities": {
      "type": "object",
      "required": ["trade_growth_lt_0", "trade_growth_le_minus_5"],
      "properties": {
        "trade_growth_lt_0": {"type": "number", "minimum": 0, "maximum": 1},
        "trade_growth_le_minus_5": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "numeric_forecast": {
      "type": "object",
      "required": ["target", "unit", "point", "interval_50", "interval_90"],
      "properties": {
        "target": {"const": "target_year_world_merchandise_trade_volume_growth"},
        "unit": {"const": "percent"},
        "point": {"type": "number"},
        "interval_50": {"$ref": "#/$defs/interval"},
        "interval_90": {"$ref": "#/$defs/interval"},
        "scope_note": {"type": "string"}
      }
    },
    "mechanisms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["name", "weight", "evidence", "disconfirming_evidence", "observable_signals"],
        "properties": {
          "name": {"type": "string"},
          "weight": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "disconfirming_evidence": {"type": "array", "items": {"type": "string"}},
          "observable_signals": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["name", "probability", "description", "triggers"],
        "properties": {
          "name": {"type": "string"},
          "probability": {"type": "number", "minimum": 0, "maximum": 1},
          "description": {"type": "string"},
          "triggers": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "next_signals": {"type": "array", "items": {"type": "string"}},
    "source_ids_used": {"type": "array", "items": {"type": "string", "pattern": "^S[0-9]{2}$"}}
  },
  "$defs": {
    "interval": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "evidenceAnchor": {
      "type": "object", "additionalProperties": false,
      "required": ["supports", "kind", "anchor", "use"],
      "properties": {
        "supports": {"type": "string"},
        "kind": {"enum": ["support", "counter", "boundary"]},
        "anchor": {"type": "string", "pattern": "^(S[0-9]{2}|FT001-[A-Z][0-9]{2})(#[A-Za-z0-9._-]+)?$"},
        "use": {"type": "string"}
      }
    },
    "updateDelta": {
      "type": "object", "additionalProperties": false,
      "required": ["changed", "unchanged", "why"],
      "properties": {
        "changed": {"type": "array", "items": {"type": "string"}},
        "unchanged": {"type": "array", "items": {"type": "string"}},
        "why": {"type": "string"}
      }
    }
  },
  "additionalProperties": false
}
